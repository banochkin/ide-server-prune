    check "older version kept" "$root/extensions/pub.ext-1.2.3" kept
    case "$out" in
        *"no version-aware sort"*) printf '  ok    and it says so\n' ;;
        *) printf '  FAIL  degraded silently\n'; failures=$(( failures + 1 )) ;;
    esac
else
    printf '  skip  no /usr/bin/sort to wrap\n'
fi

printf '\nextension versions are left alone without a usable manifest:\n'
build
rm -f "$root/extensions/extensions.json"
IDE_CLEAN_TMP=0 "$prune" -r "$root" >/dev/null 2>&1
check "older version kept"    "$root/extensions/pub.ext-1.2.3"  kept
check "newer version kept"    "$root/extensions/pub.ext-1.10.0" kept
check "obsolete still pruned" "$root/extensions/pub.old-0.1.0"  gone

build
printf '{"truncated' >"$root/extensions/extensions.json"
touch -t 202001010000 "$root/extensions/extensions.json"
IDE_CLEAN_TMP=0 "$prune" -r "$root" >/dev/null 2>&1
check "kept behind a truncated manifest" "$root/extensions/pub.ext-1.2.3" kept

