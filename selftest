# asked before it and not only before the rm: a stale install is terminated
# first and deleted after, and a target behind a symlinked parent used to be
# signalled on the way to a removal that was then refused.
printf '\nnothing is signalled for a target the containment check refuses:\n'
build
rm -rf "$work/outside"
mkdir -p "$work/outside/Stable-$C" "$work/outside/Stable-$A"
printf '["Stable-%s"]' $A >"$work/outside/lru.json"
