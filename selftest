find "$work/outside" -exec touch -t 202001010000 {} + 2>/dev/null
set -m
"$real_root/cli/servers/Stable-$C/node" >/dev/null 2>&1 &
victim=$!
set +m
sleep 1
if [ -n "$(own_pgid "$victim")" ] && [ "$(own_pgid "$victim")" != "$(own_pgid $$)" ]; then
