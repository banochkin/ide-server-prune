        failures=$(( failures + 1 ))
    fi
    case "$out" in
        *"refusing to remove outside known roots"*) printf '  ok    and the removal is still refused\n' ;;
        *) printf '  FAIL  no refusal reported\n'; failures=$(( failures + 1 )) ;;
    esac
else
    printf '  skip  no job control here\n'
fi
stop_job "$victim"

# GNU stat reads -f as --file-system, where %m is not a directive it knows: it
# answers "?" and still exits 0. Asking it that way first would shadow the
# spelling it does understand, and an mtime of 0 for everything takes the last
# fallback - "keep the newest install" - down with it.
printf '\nthe newest install is found with a GNU-style stat:\n'
mkdir -p "$work/gnu"
cat >"$work/gnu/stat" <<'STUB'
#!/bin/sh
# Stands in for a stat that answers the GNU spelling and nothing else. The
# answer to -c %Y has to be a real mtime on whichever host is running this, so
# it is asked for both ways: delegating only to the BSD spelling answers nothing
# on Linux, where -f is --file-system and %m is not a directive it knows - and
# the test would then fail on GNU coreutils, which is the very thing it is here
# to check.
case $1 in
    -c) shift
        case ${1:-} in
            '%Y') shift
                  /usr/bin/stat -c '%Y' -- "$@" 2>/dev/null && exit 0
                  exec /usr/bin/stat -f '%m' "$@" ;;
        esac
        exit 1 ;;
    -f) printf '?\n'; exit 0 ;;
esac
exec /usr/bin/stat "$@"
STUB
printf '#!/bin/sh\nexit 1\n' >"$work/gnu/blind"
chmod 755 "$work/gnu/stat" "$work/gnu/blind"
if [ -x /usr/bin/stat ]; then
    build
    rm -f "$root/cli/servers/lru.json"
    touch -t 202401010000 "$root/cli/servers/Stable-$B"
    out=$(env PATH="$work/gnu:$PATH" IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1)
    case "$out" in
        *"keeping: $B"*) printf '  ok    newest install kept\n' ;;
        *) printf '  FAIL  newest install not identified (keeping line: %s)\n' \
               "$(printf '%s\n' "$out" | grep keeping || true)"
           failures=$(( failures + 1 )) ;;
    esac

    # And with no readable mtime at all the fallback still has to answer.
    printf '\nno readable mtime keeps an install anyway:\n'
    cp "$work/gnu/blind" "$work/gnu/stat"
    build
    rm -f "$root/cli/servers/lru.json"
    out=$(env PATH="$work/gnu:$PATH" IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1)
    case "$out" in
        *"keeping: none"*)
            printf '  FAIL  every install marked stale\n'; failures=$(( failures + 1 )) ;;
        *) printf '  ok    an install is still kept\n' ;;
    esac
else
    printf '  skip  no /usr/bin/stat to wrap\n'
fi

printf '\nsudo is refused, plain root is not:\n'
build
out=$(env SUDO_USER=someone IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1 || true)
case "$out" in
    *"not through sudo"*) printf '  ok    refused under sudo\n' ;;
    *) printf '  FAIL  ran under sudo\n'; failures=$(( failures + 1 )) ;;
esac
if IDE_CLEAN_TMP=0 "$prune" -q --dry-run -r "$root" >/dev/null 2>&1; then
    printf '  ok    ordinary run unaffected\n'
else
    printf '  FAIL  ordinary run refused too\n'; failures=$(( failures + 1 ))
fi

# TMPDIR becomes a removal root for the rest of the run, so it answers the same
# question a server root does.
printf '\nan unsuitable temp directory is refused:\n'
mkdir -p "$work/home"
out=$(env HOME="$work/home" TMPDIR="$work/home" IDE_CLEAN_WORKSPACE_STORAGE=0 \
          "$prune" --dry-run -r "$root" 2>&1 || true)
case "$out" in
    *"ignoring unsuitable temp directory"*) printf '  ok    TMPDIR=$HOME ignored\n' ;;
    *) printf '  FAIL  swept $HOME as a temp directory\n'; failures=$(( failures + 1 )) ;;
esac
# A length test alone lets /var and /usr through; what matters is that the
# directory must not contain the home it would then sweep names out of.
mkdir -p "$work/home/inner"
out=$(env HOME="$work/home/inner" TMPDIR="$work/home" IDE_CLEAN_WORKSPACE_STORAGE=0 \
          "$prune" --dry-run -r "$root" 2>&1 || true)
case "$out" in
    *'contains $HOME'*) printf '  ok    a TMPDIR above $HOME ignored\n' ;;
    *) printf '  FAIL  swept a temp directory containing $HOME\n'; failures=$(( failures + 1 )) ;;
esac
# A server root has a structure to be recognised by; a temp directory has none,
# so a system path in TMPDIR is refused by name. The length test alone let every
# one of these through.
out=$(env TMPDIR=/usr IDE_CLEAN_WORKSPACE_STORAGE=0 "$prune" --dry-run -r "$root" 2>&1 || true)
case "$out" in
    *"ignoring unsuitable temp directory: /usr"*) printf '  ok    TMPDIR=/usr ignored\n' ;;
    *) printf '  FAIL  accepted /usr as a temp directory\n'; failures=$(( failures + 1 )) ;;
esac

# TMPDIR and /tmp are very often the same directory, and the pass looks at both.
# Remembering one only after the screen meant a directory the screen refuses was
# named once per spelling rather than once. $HOME is what makes /tmp refusable
# here - no other screen turns it down - and it is also the comparison the two
# platforms disagree about, since /tmp resolves to /private/tmp on macOS and to
# itself on Linux. Both spellings are refused, so the sweep is handed nothing to
# walk; --dry-run is the second belt. The lock hangs off $HOME, and XDG_CACHE_HOME
# keeps it out of the shared /tmp this hands the script as a home.
printf '\na temp directory reached twice is refused once:\n'
out=$(env HOME=/tmp TMPDIR=/tmp XDG_CACHE_HOME="$work/cache" \
          IDE_CLEAN_WORKSPACE_STORAGE=0 "$prune" --dry-run -r "$root" 2>&1 || true)
refusals=$(grep -c "ignoring unsuitable temp directory" <<<"$out" || true)
case "$refusals" in
    1) printf '  ok    named once\n' ;;
    *) printf '  FAIL  refused %s times, expected 1\n' "$refusals"
       failures=$(( failures + 1 )) ;;
esac

# Every root, guard and the lock itself hang off $HOME; without one the script
# used to fail with a bare "unbound variable" from the middle of the file.
printf '\nan unusable HOME is named rather than stumbled over:\n'
out=$(env -u HOME IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1 || true)
case "$out" in
    *"HOME must name an existing directory"*) printf '  ok    unset HOME refused\n' ;;
    *) printf '  FAIL  unset HOME (%s)\n' "$out"; failures=$(( failures + 1 )) ;;
esac
out=$(env HOME="$work/no-such-home" IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1 || true)
case "$out" in
    *"HOME must name an existing directory"*) printf '  ok    missing HOME refused\n' ;;
    *) printf '  FAIL  missing HOME (%s)\n' "$out"; failures=$(( failures + 1 )) ;;
esac

# The temp sweep promises to remove nothing a process still holds open. Reading
# lsof's exit status did not deliver that for a directory: +D exits non-zero
# after a walk it completed perfectly well, and "nothing open" reports the same
# status - so on every host without /proc each candidate directory looked free.
printf '\na temp directory something still holds open is kept:\n'
held_tmp="$work/tmpheld"
mkdir -p "$held_tmp/vscode-held" "$held_tmp/vscode-free"
printf 'x\n' >"$held_tmp/vscode-held/open.sock.log"
printf 'x\n' >"$held_tmp/vscode-free/closed.log"
find "$held_tmp" -exec touch -t 202001010000 {} + 2>/dev/null
real_held=$(cd -- "$held_tmp" && pwd -P)
( exec 9>>"$real_held/vscode-held/open.sock.log"; sleep 30 ) &
holder2=$!
sleep 1
TMPDIR="$held_tmp" IDE_CLEAN_WORKSPACE_STORAGE=0 "$prune" -r "$root" >/dev/null 2>&1
check "temp directory held open"    "$held_tmp/vscode-held" kept
check "temp directory nobody holds" "$held_tmp/vscode-free" gone
stop_holder "$holder2"

# find splits its output on newlines unless asked otherwise, and a name carrying
# one would arrive as two paths, neither of which is the file.
printf '\na temp name with a newline in it is still removed:\n'
nl_dir="$work/tmpnl"
mkdir -p "$nl_dir"
nl_name=$(printf 'vscode-a\nb')
printf 'x\n' >"$nl_dir/$nl_name"
touch -t 202001010000 "$nl_dir/$nl_name"
TMPDIR="$nl_dir" IDE_CLEAN_WORKSPACE_STORAGE=0 "$prune" -r "$root" >/dev/null 2>&1
check "temp name containing a newline" "$nl_dir/$nl_name" gone

# du -s breaks its line on a name containing a newline, so reading the last line
# of that output measured every such path as nothing. The root here is one the
# run has no reason to touch, or a removal from it would mask the zero.
printf '\na temp name with a newline is measured, not counted as zero:\n'
mkdir -p "$work/nlroot/cli/servers/Stable-$A"
printf '["Stable-%s"]' $A >"$work/nlroot/cli/servers/lru.json"
nl_dir2="$work/tmpnl2"
mkdir -p "$nl_dir2/$(printf 'vscode-c\nd')"
dd if=/dev/zero of="$nl_dir2/$(printf 'vscode-c\nd')/blob" bs=1024 count=64 2>/dev/null
find "$work/nlroot" "$nl_dir2" -exec touch -t 202001010000 {} + 2>/dev/null
out=$(TMPDIR="$nl_dir2" IDE_CLEAN_WORKSPACE_STORAGE=0 "$prune" --dry-run \
          -r "$work/nlroot" 2>&1)
case "$out" in
    *"would free 0 KB"*) printf '  FAIL  measured as nothing\n'; failures=$(( failures + 1 )) ;;
    *"would free"*)      printf '  ok    measured\n' ;;
    *) printf '  FAIL  no summary line (%s)\n' "$out"; failures=$(( failures + 1 )) ;;
esac

# Version-aware sorting is not POSIX, and busybox accepts -V while ignoring it -
# under which 1.10.0 reads as older than 1.9.0 and the newest version is the one
# that looks superseded.
printf '\nextension versions are left alone without a version-aware sort:\n'
mkdir -p "$work/nosort"
cat >"$work/nosort/sort" <<'STUB'
#!/bin/sh
for a in "$@"; do
    case $a in -*V*) exit 2 ;; esac
done
exec /usr/bin/sort "$@"
STUB
chmod 755 "$work/nosort/sort"
if [ -x /usr/bin/sort ]; then
    build
