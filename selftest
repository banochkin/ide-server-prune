# be reported as damage on every run.
build
printf '[]' >"$root/extensions/extensions.json"
touch -t 202001010000 "$root/extensions/extensions.json"
out=$(IDE_CLEAN_TMP=0 "$prune" -r "$root" 2>&1)
case "$out" in
    *"no usable extensions.json"*) printf '  FAIL  complained about an empty manifest\n'; failures=$(( failures + 1 )) ;;
    *) printf '  ok    empty manifest accepted quietly\n' ;;
esac

# A stub launchctl/systemctl keeps this inside the throwaway HOME: the check is
# what --install writes, not whether the real service manager accepts it.
printf '\n--install carries the settings it was given into the timer:\n'
mkdir -p "$work/bin" "$work/home"
for stub in launchctl systemctl loginctl; do
    printf '#!/bin/sh\nexit 0\n' >"$work/bin/$stub"
    chmod 755 "$work/bin/$stub"
done
env PATH="$work/bin:$PATH" HOME="$work/home" XDG_CONFIG_HOME="$work/home/.config" \
    IDE_KEEP_SERVERS=5 "$prune" -q --protect-live --install >/dev/null 2>&1
unit=$(cat "$work/home/Library/LaunchAgents/local.ide-server-prune.plist" \
           "$work/home/.config/systemd/user/ide-server-prune.service" 2>/dev/null || true)
case "$unit" in
    *IDE_PROTECT_LIVE*1*) printf '  ok    --protect-live written into the unit\n' ;;
    *) printf '  FAIL  --protect-live not carried over\n'; failures=$(( failures + 1 )) ;;
esac
case "$unit" in
    *IDE_KEEP_SERVERS*5*) printf '  ok    IDE_KEEP_SERVERS written into the unit\n' ;;
    *) printf '  FAIL  IDE_KEEP_SERVERS not carried over\n'; failures=$(( failures + 1 )) ;;
esac
check "installed binary" "$work/home/.local/bin/ide-server-prune" kept

# --dry-run promises the run changes nothing; installing writes a binary, a unit
# and a registration with the service manager.
printf '\n--dry-run refuses to install:\n'
mkdir -p "$work/home-n"
out=$(env PATH="$work/bin:$PATH" HOME="$work/home-n" XDG_CONFIG_HOME="$work/home-n/.config" \
          "$prune" --dry-run --install 2>&1 || true)
case "$out" in
    *"cannot be combined"*) printf '  ok    refused\n' ;;
    *) printf '  FAIL  installed during a dry run\n'; failures=$(( failures + 1 )) ;;
esac
check "no binary installed" "$work/home-n/.local/bin/ide-server-prune" gone

# -r names the roots outright; IDE_SERVER_ROOTS only adds to the ones found by
# auto-detection. Writing the first into the second is how a timer ends up
# sweeping trees the run tried by hand never looked at.
printf '\n--install carries -r as an argument, not as an extra root:\n'
mkdir -p "$work/home-r"
env PATH="$work/bin:$PATH" HOME="$work/home-r" XDG_CONFIG_HOME="$work/home-r/.config" \
    "$prune" -q -r "$root" --install >/dev/null 2>&1
unit=$(cat "$work/home-r/Library/LaunchAgents/local.ide-server-prune.plist" \
           "$work/home-r/.config/systemd/user/ide-server-prune.service" 2>/dev/null || true)
case "$unit" in
    *IDE_SERVER_ROOTS*)
        printf '  FAIL  written as IDE_SERVER_ROOTS, which only adds to auto-detection\n'
        failures=$(( failures + 1 )) ;;
    *--root*) printf '  ok    written as --root\n' ;;
    *) printf '  FAIL  -r not carried over at all\n'; failures=$(( failures + 1 )) ;;
esac
case "$unit" in
    *"$real_root"*) printf '  ok    with the resolved path\n' ;;
    *) printf '  FAIL  the root itself is missing from the unit\n'; failures=$(( failures + 1 )) ;;
esac

# The unit is regenerated from the environment of the call that writes it, so a
# second --install with a barer command line reverts what the first one
# scheduled. That stays - a unit that remembered settings could never be talked
# out of one - but every setting it drops is named on the way out.
printf '\na second --install with barer settings says what it drops:\n'
mkdir -p "$work/home-d"
env PATH="$work/bin:$PATH" HOME="$work/home-d" XDG_CONFIG_HOME="$work/home-d/.config" \
    IDE_KEEP_SERVERS=1 "$prune" -q -r "$root" --install >/dev/null 2>&1
out=$(env PATH="$work/bin:$PATH" HOME="$work/home-d" XDG_CONFIG_HOME="$work/home-d/.config" \
          "$prune" --install 2>&1)
case "$out" in
    *"IDE_KEEP_SERVERS=1 was in the installed timer"*)
        printf '  ok    the dropped tunable is named\n' ;;
    *) printf '  FAIL  the dropped tunable went unmentioned\n'; failures=$(( failures + 1 )) ;;
esac
case "$out" in
    *"the installed timer ran with --root $real_root"*)
        printf '  ok    the dropped root is named\n' ;;
    *) printf '  FAIL  the dropped root went unmentioned\n'; failures=$(( failures + 1 )) ;;
esac
# "nothing was printed" and "nothing was carried over" look identical on a
# terminal, and on a host that already has a timer the second is the answer that
# matters.
case "$out" in
    *"carrying over: nothing"*) printf '  ok    an empty carry-over says so\n' ;;
    *) printf '  FAIL  an empty carry-over printed nothing at all\n'; failures=$(( failures + 1 )) ;;
esac

# ... and the same call repeated changes nothing, so it must stay quiet: a
# warning on every re-install is a warning nobody reads.
printf '\nrepeating the same --install is silent about drift:\n'
out=$(env PATH="$work/bin:$PATH" HOME="$work/home-d" XDG_CONFIG_HOME="$work/home-d/.config" \
          "$prune" --install 2>&1)
case "$out" in
    *"installed timer"*)
        printf '  FAIL  reported drift where there is none\n'; failures=$(( failures + 1 )) ;;
    *) printf '  ok    no drift reported\n' ;;
esac

# --install copies whatever it is being run from over the installed name, so
# running it out of an old checkout rolls the scheduled job back a version.
printf '\ninstalling over a different version says so:\n'
mkdir -p "$work/home-v/.local/bin"
sed 's/^VERSION=.*/VERSION=0.1/' "$prune" >"$work/home-v/.local/bin/ide-server-prune"
chmod 755 "$work/home-v/.local/bin/ide-server-prune"
out=$(env PATH="$work/bin:$PATH" HOME="$work/home-v" XDG_CONFIG_HOME="$work/home-v/.config" \
          "$prune" --install 2>&1)
case "$out" in
    *"(version 0.1)"*) printf '  ok    the version being replaced is named\n' ;;
    *) printf '  FAIL  the binary was replaced in silence\n'; failures=$(( failures + 1 )) ;;
esac

# Only one of the two scheduling branches is native to whichever host runs this,
# so the other one is never exercised at all - and reading a unit back is new
# code on both. A stub `uname` reaches both from either platform: the unit is
# written from scratch and then read by the same code that reports drift, which
# fails loudly if either half disagrees with the other about the format.
printf '\nboth scheduling branches write a unit and read it back:\n'
for spelling in Linux Darwin; do
    mkdir -p "$work/bin-$spelling" "$work/home-$spelling"
    for stub in launchctl systemctl loginctl; do
        printf '#!/bin/sh\nexit 0\n' >"$work/bin-$spelling/$stub"
        chmod 755 "$work/bin-$spelling/$stub"
    done
    printf '#!/bin/sh\necho %s\n' "$spelling" >"$work/bin-$spelling/uname"
    chmod 755 "$work/bin-$spelling/uname"
    env PATH="$work/bin-$spelling:$PATH" HOME="$work/home-$spelling" \
        XDG_CONFIG_HOME="$work/home-$spelling/.config" IDE_KEEP_SERVERS=4 \
        "$prune" -q -r "$root" --install >/dev/null 2>&1
    out=$(env PATH="$work/bin-$spelling:$PATH" HOME="$work/home-$spelling" \
              XDG_CONFIG_HOME="$work/home-$spelling/.config" "$prune" --install 2>&1)
    case "$out" in
        *"IDE_KEEP_SERVERS=4 was in the installed timer"*)
            printf '  ok    %s: the tunable came back out of the unit\n' "$spelling" ;;
        *) printf '  FAIL  %s: the tunable did not survive the round trip\n' "$spelling"
           failures=$(( failures + 1 )) ;;
    esac
    case "$out" in
        *"ran with --root $real_root"*)
            printf '  ok    %s: and so did the root\n' "$spelling" ;;
        *) printf '  FAIL  %s: the root did not survive the round trip\n' "$spelling"
           failures=$(( failures + 1 )) ;;
    esac
done

# Enabling linger goes through polkit, which refuses a session it does not
# consider active - and a minimal VPS image ships no polkitd at all. The warning
# has to fire there, carry the command that fixes it, and stay quiet where
# linger is already on: that call is refused on such a host too, and a warning
# printed on every re-install is one nobody reads on the install where it means
# something.
printf '\nlinger that could not be enabled is reported with the fix:\n'
mkdir -p "$work/bin-lg" "$work/home-lg"
for stub in systemctl launchctl; do
    printf '#!/bin/sh\nexit 0\n' >"$work/bin-lg/$stub"
    chmod 755 "$work/bin-lg/$stub"
done
printf '#!/bin/sh\necho Linux\n' >"$work/bin-lg/uname"
chmod 755 "$work/bin-lg/uname"
cat >"$work/bin-lg/loginctl" <<'STUB'
#!/bin/sh
case $1 in
    enable-linger) exit 1 ;;
    show-user) echo "Linger=${LINGER_STATE:-no}" ;;
    *) exit 1 ;;
esac
STUB
chmod 755 "$work/bin-lg/loginctl"
out=$(env PATH="$work/bin-lg:$PATH" HOME="$work/home-lg" \
          XDG_CONFIG_HOME="$work/home-lg/.config" LINGER_STATE=no \
          "$prune" --install 2>&1)
case "$out" in
    *"linger is not enabled"*) printf '  ok    the refusal is reported\n' ;;
    *) printf '  FAIL  a refused enable-linger went unmentioned\n'; failures=$(( failures + 1 )) ;;
esac
case "$out" in
    *"sudo loginctl enable-linger"*) printf '  ok    with the command that fixes it\n' ;;
    *) printf '  FAIL  no fix offered\n'; failures=$(( failures + 1 )) ;;
esac

# The same refusal, on a host where linger is already on. The status of the call
# is identical; only the state differs, which is why the state is what is asked.
printf '\nlinger that is already on is not reported at all:\n'
out=$(env PATH="$work/bin-lg:$PATH" HOME="$work/home-lg" \
          XDG_CONFIG_HOME="$work/home-lg/.config" LINGER_STATE=yes \
          "$prune" --install 2>&1)
case "$out" in
    *linger*) printf '  FAIL  cried wolf where linger is enabled\n'; failures=$(( failures + 1 )) ;;
    *) printf '  ok    silent\n' ;;
esac

# Registering a launchd agent starts by unloading the one already there, and
# bootstrap is exactly the step that fails over SSH to a headless Mac. A failure
# there must not leave the host with no timer at all.
printf '\na launchd registration that fails puts the previous agent back:\n'
if [ "$(uname -s)" = Darwin ]; then
    mkdir -p "$work/partbin" "$work/home-b"
    cat >"$work/partbin/launchctl" <<'STUB'
#!/bin/sh
case $1 in
    bootout) exit 0 ;;
    *) exit 1 ;;
esac
STUB
    chmod 755 "$work/partbin/launchctl"
    env PATH="$work/bin:$PATH" HOME="$work/home-b" IDE_KEEP_SERVERS=3 \
        "$prune" -q --install >/dev/null 2>&1
    env PATH="$work/partbin:$PATH" HOME="$work/home-b" IDE_KEEP_SERVERS=9 \
        "$prune" -q --install >/dev/null 2>&1 || true
    plist="$work/home-b/Library/LaunchAgents/local.ide-server-prune.plist"
    if grep -q '<string>3</string>' "$plist" 2>/dev/null; then
        printf '  ok    the plist that was registered is back on disk\n'
    else
        printf '  FAIL  the failed install left its own plist in place\n'
        failures=$(( failures + 1 ))
    fi
    if [ -z "$(find "$work/home-b/Library/LaunchAgents" -name '*.prev.*' 2>/dev/null)" ]; then
        printf '  ok    no backup left behind\n'
    else
        printf '  FAIL  a backup plist was left behind\n'; failures=$(( failures + 1 ))
    fi
else
    printf '  skip  not macOS\n'
fi

# cp writes *through* a symlink, so a link left on the installed name would send
# the copy to whatever it points at instead of being replaced by it.
printf '\n--install does not write through a symlink left on its name:\n'
mkdir -p "$work/home-l/.local/bin"
printf 'precious\n' >"$work/home-l/precious"
ln -s "$work/home-l/precious" "$work/home-l/.local/bin/ide-server-prune"
env PATH="$work/bin:$PATH" HOME="$work/home-l" XDG_CONFIG_HOME="$work/home-l/.config" \
    "$prune" -q --install >/dev/null 2>&1
if [ "$(cat "$work/home-l/precious")" = precious ]; then
    printf '  ok    the link target is untouched\n'
else
    printf '  FAIL  the copy went through the symlink\n'; failures=$(( failures + 1 ))
fi
if head -n1 "$work/home-l/.local/bin/ide-server-prune" | grep -q bash; then
    printf '  ok    and the name now holds the script\n'
else
    printf '  FAIL  the script was not installed\n'; failures=$(( failures + 1 ))
fi

# The cron line is pasted into a crontab by hand, so it has to survive a shell:
# a quote in a value or a space in a root would otherwise re-split it. Stubs that
# fail take both platforms down the same path - the one that prints the hint.
printf '\nthe cron hint survives a shell:\n'
mkdir -p "$work/failbin" "$work/home-c"
for stub in launchctl systemctl; do
    printf '#!/bin/sh\nexit 1\n' >"$work/failbin/$stub"
    chmod 755 "$work/failbin/$stub"
done
hint=$(env PATH="$work/failbin:$PATH" HOME="$work/home-c" XDG_CONFIG_HOME="$work/home-c/.config" \
           IDE_TMP_PATTERNS="vscode-* its'-*" "$prune" -r "$root" --install 2>&1 |
       sed -n 's/.*instead: 30 4 \* \* \* //p')
if [ -z "$hint" ]; then
    printf '  FAIL  no cron hint printed\n'; failures=$(( failures + 1 ))
else
    eval "set -- $hint"
    got_root='' got_pattern=''
    while [ "$#" -gt 0 ]; do
        case $1 in
            --root) [ "$#" -gt 1 ] && got_root=$2 ;;
            IDE_TMP_PATTERNS=*) got_pattern=${1#IDE_TMP_PATTERNS=} ;;
        esac
        shift
    done
    if [ "$got_root" = "$real_root" ]; then
        printf '  ok    the root arrives as one argument\n'
    else
        printf '  FAIL  --root came back as "%s"\n' "$got_root"; failures=$(( failures + 1 ))
    fi
    if [ "$got_pattern" = "vscode-* its'-*" ]; then
        printf '  ok    a value with a quote in it arrives intact\n'
    else
        printf '  FAIL  IDE_TMP_PATTERNS came back as "%s"\n' "$got_pattern"
        failures=$(( failures + 1 ))
    fi
fi

printf '\n'
if [ "$failures" -eq 0 ]; then
    printf 'all checks passed\n'
else
    printf '%d check(s) failed\n' "$failures"
fi
exit $(( failures > 0 ))
