#!/usr/bin/env bash
# selftest - build a throwaway IDE server tree and check what ide-server-prune does to it.
# Touches nothing outside its own temporary directory.
set -uo pipefail

here=$(cd -- "$(dirname -- "$0")" && pwd -P)
prune="$here/ide-server-prune"
work=$(mktemp -d "${TMPDIR:-/tmp}/ide-server-prune-selftest.XXXXXX")
root="$work/.vscode-server"
# Everything the tool prints, and every path it compares a process against, has
# been through pwd -P. On macOS mktemp hands out /var/folders/... which resolves
# to /private/var/folders/..., so a check that matches its output - or a process
# whose arguments have to match a root - needs the resolved spelling.
real_work=$(cd -- "$work" && pwd -P)
real_root="$real_work/.vscode-server"
failures=0

A=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa1
B=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb2
C=ccccccccccccccccccccccccccccccccccccccc3
D=ddddddddddddddddddddddddddddddddddddddd4
E=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee5
F=fffffffffffffffffffffffffffffffffffffff6

cleanup() { rm -rf -- "$work"; }
trap cleanup EXIT

check() { # description, path, gone|kept
    local desc=$1 path=$2 want=$3 have
    if [ -e "$path" ]; then have=kept; else have=gone; fi
    if [ "$have" = "$want" ]; then
        printf '  ok    %s\n' "$desc"
    else
        printf '  FAIL  %s (expected %s, got %s)\n' "$desc" "$want" "$have"
        failures=$(( failures + 1 ))
    fi
}

build() {
    rm -rf -- "$root"
    local c
    for c in $A $B $C; do
        mkdir -p "$root/cli/servers/Stable-$c/server"
        dd if=/dev/zero of="$root/cli/servers/Stable-$c/server/node" bs=1024 count=64 2>/dev/null
    done
    mkdir -p "$root/cli/servers/Stable-$D.staging/server" "$root/bin/$E"
    printf '["Stable-%s","Stable-%s","Stable-%s"]' $A $B $C >"$root/cli/servers/lru.json"
    printf 'agent log\n' >"$root/cli/agent-host-stable.log"
    printf 'lock\n' >"$root/cli/agent-host-stable.lock"
    for c in $A $C; do printf 'bin\n' >"$root/code-$c"; printf 'log\n' >"$root/.cli.$c.log"; done
    printf 'log\n' >"$root/.$E.log"; printf '1\n' >"$root/.$E.pid"; printf 't\n' >"$root/.$E.token"

    mkdir -p "$root/data/CachedExtensionVSIXs" "$root/data/CachedData/$A" \
             "$root/data/CachedData/$E" "$root/data/logs/20200101T000000"
    printf x >"$root/data/logs/20200101T000000/f"

    mkdir -p "$root/data/User/workspaceStorage/gone" "$root/data/User/workspaceStorage/empty" \
             "$root/data/User/workspaceStorage/live" "$root/data/User/workspaceStorage/unmounted" \
             "$root/data/User/workspaceStorage/undecodable"
    # Deleted from a directory that is still there: the one case where the folder
    # really is gone rather than merely out of reach. %20 on the way, because a
    # workspace path arrives percent-encoded.
    printf '{"folder":"file://%s/gone%%20project"}' "$work" \
        >"$root/data/User/workspaceStorage/gone/workspace.json"
    printf '{"folder":"file://%s/not-mounted/project"}' "$work" \
        >"$root/data/User/workspaceStorage/unmounted/workspace.json"
    printf '{"folder":"file://%s/100%%done"}' "$work" \
        >"$root/data/User/workspaceStorage/undecodable/workspace.json"
    printf '{"folder":"file://%s"}' "$work" >"$root/data/User/workspaceStorage/live/workspace.json"

    mkdir -p "$root/extensions/pub.ext-1.2.3" "$root/extensions/pub.ext-1.10.0" \
             "$root/extensions/pub.ext-2.0.0-linux-x64" "$root/extensions/pub.old-0.1.0" \
             "$root/extensions/foo.bar-1.0.0.vsctmp"
    printf '[{"identifier":{"id":"pub.ext"},"relativeLocation":"pub.ext-1.10.0"}]' \
        >"$root/extensions/extensions.json"
    printf '{"pub.old-0.1.0":true}' >"$root/extensions/.obsolete"

    # Everything must look old, or the freshness guard skips it.
    find "$root" -exec touch -t 202001010000 {} + 2>/dev/null
}

printf 'ide-server-prune selftest in %s\n\n' "$work"

printf 'dry run changes nothing:\n'
build
before=$(find "$root" | sort)
IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" >/dev/null 2>&1
after=$(find "$root" | sort)
if [ "$before" = "$after" ]; then printf '  ok    tree untouched\n'; else printf '  FAIL  dry run modified the tree\n'; failures=$(( failures + 1 )); fi

printf '\nreal run:\n'
build
IDE_CLEAN_TMP=0 "$prune" -r "$root" >/dev/null 2>&1

check "LRU head kept"                  "$root/cli/servers/Stable-$A"            kept
check "second LRU entry kept"          "$root/cli/servers/Stable-$B"            kept
check "third LRU entry pruned"         "$root/cli/servers/Stable-$C"            gone
check "abandoned .staging pruned"      "$root/cli/servers/Stable-$D.staging"    gone
check "legacy bin/<commit> pruned"     "$root/bin/$E"                           gone
check "cli binary of kept version"     "$root/code-$A"                          kept
check "cli binary of stale version"    "$root/code-$C"                          gone
check "cli log of kept version"        "$root/.cli.$A.log"                      kept
check "cli log of stale version"       "$root/.cli.$C.log"                      gone
check "legacy .<commit>.pid pruned"    "$root/.$E.pid"                          gone
check "agent host lock untouched"      "$root/cli/agent-host-stable.lock"       kept
check "stale agent log pruned"         "$root/cli/agent-host-stable.log"        gone
check "VSIX cache pruned"              "$root/data/CachedExtensionVSIXs"        gone
check "code cache of kept version"     "$root/data/CachedData/$A"               kept
check "code cache of stale version"    "$root/data/CachedData/$E"               gone
check "old session log pruned"         "$root/data/logs/20200101T000000"        gone
check "storage of missing workspace"   "$root/data/User/workspaceStorage/gone"  gone
check "empty workspace storage"        "$root/data/User/workspaceStorage/empty" gone
check "storage of live workspace"      "$root/data/User/workspaceStorage/live"  kept
check "storage behind a missing parent" "$root/data/User/workspaceStorage/unmounted"   kept
check "storage with an unreadable path" "$root/data/User/workspaceStorage/undecodable" kept
check "interrupted extension install"  "$root/extensions/foo.bar-1.0.0.vsctmp"  gone
check "extension marked obsolete"      "$root/extensions/pub.old-0.1.0"         gone
check "superseded extension"           "$root/extensions/pub.ext-1.2.3"         gone
check "extension in extensions.json"   "$root/extensions/pub.ext-1.10.0"        kept
check "newest extension"               "$root/extensions/pub.ext-2.0.0-linux-x64" kept

expected="[\"Stable-$A\",\"Stable-$B\"]"
actual=$(cat "$root/cli/servers/lru.json")
if [ "$actual" = "$expected" ]; then
    printf '  ok    lru.json filtered to surviving installs\n'
else
    printf '  FAIL  lru.json is %s, expected %s\n' "$actual" "$expected"
    failures=$(( failures + 1 ))
fi

# An entry pointing at an install that is no longer on disk must not fill a keep
# slot, or the set stays non-empty, the "keep the newest install" fallback never
# fires, and every install actually present looks stale.
printf '\nan lru.json entry whose install is gone does not occupy a keep slot:\n'
build
printf '["Stable-%s","Stable-%s"]' $F $A >"$root/cli/servers/lru.json"
touch -t 202001010000 "$root/cli/servers/lru.json"
out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1)
keeping=$(printf '%s\n' "$out" | grep '  keeping:' || true)
case "$keeping" in
    *"$F"*) printf '  FAIL  kept a commit with no install (%s)\n' "$keeping"; failures=$(( failures + 1 )) ;;
    *"$A"*) printf '  ok    the slot went to an install that exists\n' ;;
    *) printf '  FAIL  unexpected keep set (%s)\n' "$keeping"; failures=$(( failures + 1 )) ;;
esac

printf '\nan lru.json listing nothing that exists falls back to the newest install:\n'
build
printf '["Stable-%s"]' $F >"$root/cli/servers/lru.json"
touch -t 202001010000 "$root/cli/servers/lru.json"
out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1)
case "$out" in
    *"keeping: none"*) printf '  FAIL  every install marked stale\n'; failures=$(( failures + 1 )) ;;
    *"keeping: $F"*)   printf '  FAIL  kept a commit with no install\n'; failures=$(( failures + 1 )) ;;
    *) printf '  ok    an install that exists is still kept\n' ;;
esac

# Documented, and worth pinning: 0 empties the keep set outright, so the newest
# install fallback does not fire either.
printf '\n--keep 0 keeps nothing but the session:\n'
build
out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run --keep 0 -r "$root" 2>&1)
case "$out" in
    *"keeping: none"*) printf '  ok    keep set empty\n' ;;
    *) printf '  FAIL  --keep 0 kept something\n'; failures=$(( failures + 1 )) ;;
esac
case "$out" in
    *"would remove $real_root/cli/servers/Stable-$A"*) printf '  ok    the LRU head is removed too\n' ;;
    *) printf '  FAIL  the LRU head survived --keep 0\n'; failures=$(( failures + 1 )) ;;
esac

# An empty array is what this tool itself writes once the last install is gone,
# and grep reports a file with no matches with a non-zero status. Under pipefail
# that status used to become the assignment's and end the run mid-sweep - so from
# the second run onwards every pass after lru.json was silently skipped.
printf '\nan empty lru.json does not cut the run short:\n'
build
printf '[]' >"$root/cli/servers/lru.json"
touch -t 202001010000 "$root/cli/servers/lru.json"
out=$(IDE_CLEAN_TMP=0 "$prune" -r "$root" 2>&1)
case "$out" in
    *"freed"*) printf '  ok    the sweep reached its summary\n' ;;
    *) printf '  FAIL  the run stopped early (%s)\n' "$out"; failures=$(( failures + 1 )) ;;
esac
check "a later pass still ran" "$root/extensions/pub.old-0.1.0" gone

# The same failure mode from the other side: reading the file, not grepping it.
# The read is a plain assignment, so under set -e its status ends the run - and
# writability was asked about while readability was not, which left a file we
# could write but not read aborting the sweep before its summary. Skipped as
# root, where mode 200 keeps nothing out.
printf '\nan unreadable lru.json does not cut the run short:\n'
if [ "$(id -u)" -eq 0 ]; then
    printf '  skip  running as root, mode 200 is no obstacle\n'
else
    build
    chmod 200 "$root/cli/servers/lru.json"
    out=$(IDE_CLEAN_TMP=0 "$prune" -r "$root" 2>&1 || true)
    chmod 600 "$root/cli/servers/lru.json"
    case "$out" in
        *"freed"*) printf '  ok    the sweep reached its summary\n' ;;
        *) printf '  FAIL  the run stopped at lru.json (%s)\n' "$out"
           failures=$(( failures + 1 )) ;;
    esac
    check "a later pass still ran" "$root/extensions/pub.old-0.1.0" gone
fi

# The same thing, reached the way a host actually reaches it.
printf '\nthe run after a --keep 0 clean slate still completes:\n'
build
IDE_CLEAN_TMP=0 "$prune" -q --keep 0 -r "$root" >/dev/null 2>&1
if IDE_CLEAN_TMP=0 "$prune" -q -r "$root" >/dev/null 2>&1; then
    printf '  ok    completed\n'
else
    printf '  FAIL  the run after --keep 0 exits non-zero\n'; failures=$(( failures + 1 ))
fi

printf '\nlru.json in an unknown format is left alone:\n'
build
printf '{"servers":["Stable-%s"]}' $A >"$root/cli/servers/lru.json"
IDE_CLEAN_TMP=0 "$prune" -q -r "$root" >/dev/null 2>&1
if [ "$(cat "$root/cli/servers/lru.json")" = "{\"servers\":[\"Stable-$A\"]}" ]; then
    printf '  ok    left untouched\n'
else
    printf '  FAIL  rewrote an lru.json it does not understand\n'
    failures=$(( failures + 1 ))
fi

# Isolated HOME, so the check can never disturb a lock held by a real run.
printf '\nrun in progress is refused:\n'
mkdir -p "$work/home/.cache"
lock="$work/home/.cache/.ide-server-prune.lock"
mkdir -p "$lock" && printf '%s\n' "$$" >"$lock/pid"
if env HOME="$work/home" XDG_RUNTIME_DIR= XDG_CACHE_HOME= IDE_CLEAN_TMP=0 \
        "$prune" -q -r "$root" >/dev/null 2>&1; then
    printf '  FAIL  ran while another instance held the lock\n'
    failures=$(( failures + 1 ))
else
    printf '  ok    refused\n'
fi
rm -rf -- "$lock"

printf '\nstale lock is taken over:\n'
mkdir -p "$lock" && printf '999999\n' >"$lock/pid"
if env HOME="$work/home" XDG_RUNTIME_DIR= XDG_CACHE_HOME= IDE_CLEAN_TMP=0 \
        "$prune" -q -r "$root" >/dev/null 2>&1; then
    printf '  ok    took over\n'
else
    printf '  FAIL  refused to run behind a dead lock holder\n'
    failures=$(( failures + 1 ))
fi

# A symlinked parent inside the tree must not redirect a removal out of it.
printf '\nremoval outside the resolved root is refused:\n'
build
rm -rf "$work/outside"
mkdir -p "$work/outside/Stable-$C/server" "$work/outside/Stable-$A"
printf 'precious\n' >"$work/outside/Stable-$C/keepme"
# The kept entry has to exist behind the link as well: an lru.json naming an
# install that is not there no longer occupies a keep slot, and with nothing
# left to remove the refusal under test would never be reached.
printf '["Stable-%s"]' $A >"$work/outside/lru.json"
rm -rf "$root/cli/servers"
ln -s "$work/outside" "$root/cli/servers"
find "$work/outside" -exec touch -t 202001010000 {} + 2>/dev/null
out=$(IDE_CLEAN_TMP=0 "$prune" -r "$root" 2>&1)
check "target behind a symlinked parent" "$work/outside/Stable-$C/keepme" kept
case "$out" in
    *"refusing to remove outside known roots"*) printf '  ok    and it says so\n' ;;
    *) printf '  FAIL  no refusal reported\n'; failures=$(( failures + 1 )) ;;
esac

# A name read out of .obsolete must not be able to walk up out of extensions/.
printf '\ndirectory traversal from .obsolete is refused:\n'
build
mkdir -p "$work/outside"
printf 'precious\n' >"$work/outside/keepme"
printf '{"../../../outside":true}' >"$root/extensions/.obsolete"
touch -t 202001010000 "$root/extensions/.obsolete"
out=$(IDE_CLEAN_TMP=0 "$prune" -r "$root" 2>&1)
check "target above the extensions dir" "$work/outside/keepme" kept
case "$out" in
    *"suspicious .obsolete entry"*) printf '  ok    and it says so\n' ;;
    *) printf '  FAIL  no refusal reported\n'; failures=$(( failures + 1 )) ;;
esac

# A root named by hand -- --root or IDE_SERVER_ROOTS -- has to look like a server
# tree, or a typo would aim the whole run at something unrelated.
printf '\na root that is not a server tree is refused:\n'
mkdir -p "$work/notaserver/data/logs"
out=$(IDE_CLEAN_TMP=0 "$prune" -r "$work/notaserver" 2>&1 || true)
case "$out" in
    *"does not look like an IDE server root"*) printf '  ok    --root refused\n' ;;
    *) printf '  FAIL  --root accepted a foreign directory\n'; failures=$(( failures + 1 )) ;;
esac
out=$(IDE_CLEAN_TMP=0 IDE_SERVER_ROOTS="$work/notaserver" "$prune" 2>&1 || true)
case "$out" in
    *"does not look like an IDE server root"*) printf '  ok    IDE_SERVER_ROOTS refused\n' ;;
    *) printf '  FAIL  IDE_SERVER_ROOTS accepted a foreign directory\n'; failures=$(( failures + 1 )) ;;
esac

# bin plus data is an ordinary shape for a directory to have. Auto-detection
# reaches every ~/.*-server by name, so a tree carrying nothing else of an IDE
# about it must not be adopted - the caches and data/logs passes are
# unconditional, and would sweep a stranger's logs on the next run.
printf '\na ~/.*-server that is not an IDE tree is not adopted:\n'
rm -rf "$work/fakehome"
mkdir -p "$work/fakehome/.myapp-server/bin" "$work/fakehome/.myapp-server/data/logs/old"
printf 'precious\n' >"$work/fakehome/.myapp-server/data/logs/old/app.log"
find "$work/fakehome" -exec touch -t 202001010000 {} + 2>/dev/null
out=$(env HOME="$work/fakehome" IDE_CLEAN_TMP=0 "$prune" --dry-run 2>&1 || true)
check "logs of a foreign ~/.*-server" "$work/fakehome/.myapp-server/data/logs/old/app.log" kept
case "$out" in
    *"no IDE server roots found"*) printf '  ok    not adopted\n' ;;
    *) printf '  FAIL  adopted a foreign tree (%s)\n' "$out"; failures=$(( failures + 1 )) ;;
esac
# The legacy layout has no cli/servers to be recognised by, so it is recognised
# by the marks the editor does leave beside it. That has to keep working.
mkdir -p "$work/fakehome/.myapp-server/data/User"
find "$work/fakehome" -exec touch -t 202001010000 {} + 2>/dev/null
out=$(env HOME="$work/fakehome" IDE_CLEAN_TMP=0 "$prune" --dry-run 2>&1 || true)
case "$out" in
    *"no IDE server roots found"*)
        printf '  FAIL  a legacy tree with data/User is no longer recognised\n'
        failures=$(( failures + 1 )) ;;
    *) printf '  ok    a legacy tree with data/User still is\n' ;;
esac

printf '\na root with no installs and no lru.json is not fatal:\n'
mkdir -p "$work/bare/cli/servers"
if IDE_CLEAN_TMP=0 "$prune" -q -r "$work/bare" >/dev/null 2>&1; then
    printf '  ok    completed\n'
else
    printf '  FAIL  exited non-zero on an empty root\n'
    failures=$(( failures + 1 ))
fi

# /tmp is a symlink to /private/tmp on macOS; find will not descend into a
# symlinked starting point, so the temp pass has to resolve it first.
printf '\na symlinked temp directory is resolved:\n'
mkdir -p "$work/realtmp/vscode-stale"
touch -t 202001010000 "$work/realtmp/vscode-stale"
ln -s "$work/realtmp" "$work/tmplink"
out=$(TMPDIR="$work/tmplink" "$prune" --dry-run -r "$root" 2>&1)
case "$out" in
    *"$real_work/realtmp/vscode-stale"*) printf '  ok    scanned through the symlink\n' ;;
    *) printf '  FAIL  temp entry behind a symlinked TMPDIR not seen\n'; failures=$(( failures + 1 )) ;;
esac

printf '\na tunable that is not a number is refused, not ignored:\n'
refuses() { # env assignment - has to fail, and has to name the variable
    local assignment=$1 name=${1%%=*} out rc=0
    out=$(env "$assignment" IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1) || rc=$?
    if [ "$rc" -eq 0 ]; then
        printf '  FAIL  %s accepted\n' "$assignment"; failures=$(( failures + 1 )); return
    fi
    case "$out" in
        *"$name"*) printf '  ok    %s refused\n' "$assignment" ;;
        *) printf '  FAIL  %s refused without naming it\n' "$assignment"; failures=$(( failures + 1 )) ;;
    esac
}
accepts() { # env assignment - empty means "use the default", wider patterns are the caller's call
    local assignment=$1
    if env "$assignment" IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" >/dev/null 2>&1; then
        printf '  ok    %s accepted\n' "$assignment"
    else
        printf '  FAIL  %s rejected\n' "$assignment"; failures=$(( failures + 1 ))
    fi
}
build
refuses IDE_FRESH_GUARD_MINUTES=abc
refuses IDE_STAGING_MIN_AGE_HOURS=abc
refuses IDE_KILL_GRACE_SECONDS=1.5
refuses IDE_WORKSPACE_MIN_AGE_DAYS=-1
refuses IDE_PROTECT_LIVE=yes
refuses IDE_CLEAN_EXTENSIONS=true
refuses 'IDE_TMP_PATTERNS=*'
refuses 'IDE_TMP_PATTERNS=../vscode-*'
accepts IDE_LOG_RETENTION_DAYS=
accepts 'IDE_TMP_PATTERNS=code-* mcp-*'

# --install writes tunables into a unit one per line, so a value carrying a
# newline would be split there into a second, bogus entry.
printf '\na tunable carrying a newline is refused:\n'
out=$(env "IDE_SERVER_ROOTS=$(printf '%s\nIDE_INJECTED' "$root")" IDE_CLEAN_TMP=0 \
          "$prune" --dry-run 2>&1 || true)
case "$out" in
    *"must not contain a newline"*) printf '  ok    refused\n' ;;
    *) printf '  FAIL  accepted a multi-line value\n'; failures=$(( failures + 1 )) ;;
esac

# The freshness guard is the one that used to fail open: find -mmin -abc matches
# nothing, so a brand new install looked stale.
printf '\nthe freshness guard still holds for a fresh install:\n'
build
touch "$root/cli/servers/Stable-$C"
out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run -r "$root" 2>&1)
case "$out" in
    *"skipping fresh install"*) printf '  ok    fresh install skipped\n' ;;
    *) printf '  FAIL  fresh install not protected\n'; failures=$(( failures + 1 )) ;;
esac

# A staging directory is never in the keep set, so its own age guard is all a
# download in flight has - and the transfer writes inside it, not to it.
printf '\na download still being written is left alone:\n'
build
mkdir -p "$root/cli/servers/Stable-$F.staging/server"
touch -t 202001010000 "$root/cli/servers/Stable-$F.staging" \
                      "$root/cli/servers/Stable-$F.staging/server"
printf 'partial\n' >"$root/cli/servers/Stable-$F.staging/server/vscode-server.tar.gz"
IDE_CLEAN_TMP=0 "$prune" -r "$root" >/dev/null 2>&1
check "staging directory being written" "$root/cli/servers/Stable-$F.staging" kept
check "abandoned staging still pruned"  "$root/cli/servers/Stable-$D.staging" gone

# Background jobs need their own process group, or the pruner - which skips its
# own - would filter them out and the two checks below would pass vacuously.
own_pgid() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }
stop_job() { # pid - a job started under set -m, so it owns its process group
    local pg
    pg=$(own_pgid "$1")
    [ -n "$pg" ] && kill -KILL -"$pg" 2>/dev/null
    kill -KILL "$1" 2>/dev/null
    wait "$1" 2>/dev/null
    return 0
}

# A plain background job stays in *our* process group, so stop_job would take
# this script down with it. Nothing here needs a group of its own: these hold a
# descriptor open for path_in_use, they are not processes the pruner has to see.
stop_holder() { # pid
    kill -KILL "$1" 2>/dev/null
    wait "$1" 2>/dev/null
    return 0
}

# Stable-<commit> is a prefix of Stable-<commit>.staging: removing the finished
# install must not take the download meant to replace it down with it.
printf '\na download in flight survives the removal of its predecessor:\n'
build
mkdir -p "$root/cli/servers/Stable-$F.staging/server"
printf '#!/bin/sh\nsleep 30\n' >"$root/cli/servers/Stable-$F.staging/server/download"
chmod 755 "$root/cli/servers/Stable-$F.staging/server/download"
mkdir -p "$root/cli/servers/Stable-$F"
touch -t 202001010000 "$root/cli/servers/Stable-$F"
set -m
"$real_root/cli/servers/Stable-$F.staging/server/download" >/dev/null 2>&1 &
downloader=$!
set +m
sleep 1
if [ -n "$(own_pgid "$downloader")" ] && [ "$(own_pgid "$downloader")" != "$(own_pgid $$)" ]; then
    out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run --no-protect-live -r "$root" 2>&1)
    case "$out" in
        *"would terminate pids"*)
            printf '  FAIL  the downloader was targeted (%s)\n' \
                "$(printf '%s\n' "$out" | grep 'would terminate' || true)"
            failures=$(( failures + 1 )) ;;
        *) printf '  ok    downloader left alone\n' ;;
    esac
    case "$out" in
        *"would remove $real_root/cli/servers/Stable-$F  "*)
            printf '  ok    its predecessor still pruned\n' ;;
        *) printf '  FAIL  the stale install was not pruned\n'; failures=$(( failures + 1 )) ;;
    esac
else
    printf '  skip  no job control here\n'
fi
stop_job "$downloader"

# A staging directory is never in the keep set - no commit is recorded for a
# version nobody could start yet - so PROTECT_LIVE has nothing to hold it by and
# the path itself has to be asked about. Without that, an unattended sweep
# terminates a transfer that has merely stalled.
printf '\na stalled download with a live process survives --protect-live:\n'
build
mkdir -p "$root/cli/servers/Stable-$F.staging/server"
printf '#!/bin/sh\nsleep 30\n' >"$root/cli/servers/Stable-$F.staging/server/download"
chmod 755 "$root/cli/servers/Stable-$F.staging/server/download"
find "$root/cli/servers/Stable-$F.staging" -exec touch -t 202001010000 {} + 2>/dev/null
set -m
"$real_root/cli/servers/Stable-$F.staging/server/download" >/dev/null 2>&1 &
stalled=$!
set +m
sleep 1
if [ -n "$(own_pgid "$stalled")" ] && [ "$(own_pgid "$stalled")" != "$(own_pgid $$)" ]; then
    out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run --protect-live -r "$root" 2>&1)
    case "$out" in
        *"skipping live download"*) printf '  ok    left alone\n' ;;
        *) printf '  FAIL  a live download was targeted under --protect-live\n'
           failures=$(( failures + 1 )) ;;
    esac
    # And it is only the flag doing that, not the age guard quietly skipping the
    # whole candidate - or the check above would pass without protecting anything.
    out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run --no-protect-live -r "$root" 2>&1)
    case "$out" in
        *"would remove $real_root/cli/servers/Stable-$F.staging"*)
            printf '  ok    and --no-protect-live still sweeps it\n' ;;
        *) printf '  FAIL  the stalled download was not swept without the flag\n'
           failures=$(( failures + 1 )) ;;
    esac
else
    printf '  skip  no job control here\n'
fi
stop_job "$stalled"

# The legacy layout names a directory after the bare commit, with none of the
# Name- prefix the modern one carries; a pattern asking only for the latter never
# matches a legacy orphan at all.
printf '\nan orphan process from the legacy bin/<commit> layout is swept:\n'
build
mkdir -p "$root/bin/$F"
printf '#!/bin/sh\nsleep 30\n' >"$root/bin/$F/node"
chmod 755 "$root/bin/$F/node"
set -m
"$real_root/bin/$F/node" >/dev/null 2>&1 &
orphan=$!
set +m
sleep 1
rm -rf "$root/bin/$F"
if [ -n "$(own_pgid "$orphan")" ] && [ "$(own_pgid "$orphan")" != "$(own_pgid $$)" ]; then
    out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run --no-protect-live -r "$root" 2>&1)
    case "$out" in
        *"orphan process"*) printf '  ok    reported\n' ;;
        *) printf '  FAIL  legacy orphan not seen\n'; failures=$(( failures + 1 )) ;;
    esac
else
    printf '  skip  no job control here\n'
fi
stop_job "$orphan"

# Reporting an orphan is not sweeping one. The signalling used to sit inside the
# loop with a hard one-second pause, which both ignored IDE_KILL_GRACE_SECONDS
# and served that pause once per orphan.
printf '\nan orphan process is actually signalled:\n'
build
mkdir -p "$root/bin/$F"
printf '#!/bin/sh\nsleep 30\n' >"$root/bin/$F/node"
chmod 755 "$root/bin/$F/node"
set -m
"$real_root/bin/$F/node" >/dev/null 2>&1 &
orphan2=$!
set +m
sleep 1
rm -rf "$root/bin/$F"
if [ -n "$(own_pgid "$orphan2")" ] && [ "$(own_pgid "$orphan2")" != "$(own_pgid $$)" ]; then
    # This is the one job the pruner is meant to kill, and bash announces the
    # death of a job it started under set -m on stderr, before the next command
    # runs. The checks themselves print to stdout, so silencing stderr across
    # the two commands that straddle the announcement keeps the report clean
    # without hiding anything a check would have said.
    {
        IDE_CLEAN_TMP=0 IDE_KILL_GRACE_SECONDS=2 "$prune" --no-protect-live -r "$root" >/dev/null 2>&1
        # kill -0 succeeds on a zombie, and this one is our own child - so ask
        # for the state rather than for existence.
        state=$(ps -o state= -p "$orphan2" 2>/dev/null | tr -d ' ')
    } 2>/dev/null
    case "$state" in
        ''|Z*) printf '  ok    swept\n' ;;
        *) printf '  FAIL  the orphan survived (state %s)\n' "$state"
           failures=$(( failures + 1 )) ;;
    esac
else
    printf '  skip  no job control here\n'
fi
stop_job "$orphan2"

# An orphan is a process with no install left, not a process that merely names
# one. Reading only the first path out of its arguments made a live server whose
# argv happens to mention a tree an earlier run removed - before the tree it is
# actually running out of - look like an orphan, and the sweep meant to clean up
# after dead sessions killed a live one. The launcher lives outside the tree so
# that the removed path comes first in argv, which is the ordering that breaks it.
printf '\na process that also names a live install is not an orphan:\n'
build
mkdir -p "$root/bin/$F"
printf '#!/bin/sh\nsleep 30\n' >"$work/launcher"
chmod 755 "$work/launcher"
set -m
"$work/launcher" "$real_root/bin/$F/node" \
    "$real_root/cli/servers/Stable-$A/server/node" >/dev/null 2>&1 &
mixed=$!
set +m
sleep 1
rm -rf "$root/bin/$F"
if [ -n "$(own_pgid "$mixed")" ] && [ "$(own_pgid "$mixed")" != "$(own_pgid $$)" ]; then
    out=$(IDE_CLEAN_TMP=0 "$prune" --dry-run --no-protect-live -r "$root" 2>&1)
    case "$out" in
        *"orphan process $mixed"*)
            printf '  FAIL  a process running from a live install was swept\n'
            failures=$(( failures + 1 )) ;;
        *) printf '  ok    left alone\n' ;;
    esac
else
    printf '  skip  no job control here\n'
fi
stop_job "$mixed"

# A session log directory older than the retention window can still belong to a
# session that has simply been up longer than that. The CLI logs beside it have
# always been asked whether anything holds them open; these had not been.
printf '\na log directory something still writes to is kept:\n'
build
mkdir -p "$root/data/logs/20200101T000001"
printf 'x\n' >"$root/data/logs/20200101T000001/live.log"
touch -t 202001010000 "$root/data/logs/20200101T000001" \
